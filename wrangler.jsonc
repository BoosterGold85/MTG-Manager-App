{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtg-manager-app",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  // Branch-only Brew Lab preview build. Do not merge this override into main.
  "build": {"command": "npm run build:brew-lab"},
  // Required by Cloudflare's non-production `npx wrangler preview` command.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {"enabled": true}
}
